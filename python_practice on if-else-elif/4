# If operator is "+"
#     add the numbers
#
# If operator is "-"
#     subtract the numbers
#
# If operator is "*"
#     multiply the numbers
#
# If operator is "/"
#     divide the numbers
#
# Otherwise
#     print "Invalid operator"

num1 = float(input("Enter first number: "))
num2 = float(input("Enter second number: "))

operator = input("Enter operator (+, -, *, /): ")

if operator == "+":
    print(num1+num2)
elif operator == "-":
    print(num1-num2)
elif operator == "*":
    print(num1*num2)
elif operator == "/":
    print(num1/num2)
else:
    print("Invalid Operator")